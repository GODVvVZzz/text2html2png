{
  "name": "text2html2png-skill-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "Local, offline-first HTML-to-PNG runtime for the text2html2png agent skill.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GODVvVZzz/text2html2png.git",
    "directory": "skills/text2html2png"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "SKILL.md",
    "agents/",
    "assets/",
    "examples/",
    "references/",
    "schemas/",
    "scripts/",
    "package-lock.json"
  ],
  "scripts": {
    "check": "npm run check:skill && npm run check:styles && npm run check:examples && npm run check:privacy && npm test && npm run check:layout",
    "check:examples": "node scripts/build-examples.mjs --check",
    "check:layout": "node scripts/build-examples.mjs --audit",
    "check:privacy": "node scripts/privacy-check.mjs",
    "check:skill": "node scripts/validate-skill.mjs",
    "check:styles": "node scripts/validate-style-contract.mjs",
    "audit:layout": "node scripts/audit-layout.mjs",
    "render:examples": "node scripts/build-examples.mjs --render --force",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "puppeteer-core": "25.9.0",
    "subset-font": "^2.7.0"
  }
}
